{
  "expo": {
    "name": "Samesy",
    "slug": "aligned-rn",
    "scheme": "samesy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F4EEE4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.loukarver.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Samesy to access your camera to scan pairing QR codes.",
        "NSPhotoLibraryUsageDescription": "Allow Samesy to access your photo library for profile photos and shared memories.",
        "NSMicrophoneUsageDescription": "Allow Samesy to access your microphone for voice notes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EEE4"
      },
      "package": "com.loukarver.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Samesy to save photos to your device.",
          "savePhotosPermission": "Allow Samesy to save photos to your device.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Samesy to access your microphone for voice notes."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "bbb297ac-7138-4d0c-a127-b62cecd20885"
      }
    }
  }
}
